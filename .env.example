# Page Pulse Configuration
# Copy this file to .env and adjust values as needed.

# Redis connection URL (optional - falls back to in-memory cache)
# For Upstash: rediss://<user>:<password>@<host>:<port>
REDIS_URL=

# Cache time-to-live in seconds (default: 300)
CACHE_TTL=300

# HTTP request timeout in seconds (default: 10.0)
REQUEST_TIMEOUT=10.0

# Maximum concurrent outbound HTTP requests (default: 10)
MAX_CONCURRENT_REQUESTS=10

# Rate limit for POST /audit (default: 10/minute)
RATE_LIMIT=10/minute

# Logging level (default: INFO)
LOG_LEVEL=INFO

# Environment: development | production (default: production)
ENVIRONMENT=development
